  },
  "items": [
    {
      "info": {
        "name": "A2A",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Agent Card",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agno.com/a2a/agents/:id/.well-known/agent-card.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Agent Card"
        },
        {
          "info": {
            "name": "Run Message Agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agno.com/a2a/agents/:id/v1/message:send",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Send a message to an Agno Agent (non-streaming). The Agent is identified via the path parameter '{id}'. Optional: Pass user ID via X-User-ID header (recommended) or 'userId' in params.message.metadata."
        },
        {
          "info": {
            "name": "Get Agent Task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agno.com/a2a/agents/:id/v1/tasks:get",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the status and result of an agent task by ID."
        },
        {
          "info": {
            "name": "Cancel Agent Task",
            "type": "http"
          },
          "http": {
            "method": "POST",
